{
  // Type declarations for the npm package (types/), from the JSDoc of the
  // sources: `npm run types`, run before packing
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "rootDir": "src",
    "outDir": "types"
  },
  "include": ["src/**/*.js"]
}
